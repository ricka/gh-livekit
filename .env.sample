# Copy to .env and fill in. See README.md.

# The GitHub App's App ID
GITHUB_APP_ID=

# Absolute path to the app's private key (.pem)
GITHUB_APP_PRIVATE_KEY_PATH=

# Optional: only needed if the app has more than one installation
# GITHUB_APP_INSTALLATION_ID=

# Optional: base64-encoded PEM, used instead of GITHUB_APP_PRIVATE_KEY_PATH
# GITHUB_APP_PRIVATE_KEY_B64=
